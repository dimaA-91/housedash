[Unit]
Description=HouseDash fixed phone recovery action

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/lib/housedash/phone-control.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeDirectory=housedash-phone-control
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStartSec=8
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/housedash-phone-control
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
