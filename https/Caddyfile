{
    admin off
    auto_https disable_redirects
    http_port 8080
    https_port 8443
    skip_install_trust
    pki {
        ca local {
            # Name from the first installations. Kept so phones that already trust this root keep working.
            name "FamilyOS Local Authority"
        }
    }
}

http://{$HOUSEDASH_HOSTNAME}.local {
    handle /housedash-root.crt {
        root * /data/caddy/pki/authorities/local
        rewrite * /root.crt
        header Content-Type application/x-x509-ca-cert
        header Content-Disposition "attachment; filename=housedash-root.crt"
        file_server
    }
    # Older guides linked the certificate under its previous name.
    redir /familyos-root.crt /housedash-root.crt 301
    handle {
        redir https://{$HOUSEDASH_HOSTNAME}.local{uri} 302
    }
}

https://{$HOUSEDASH_HOSTNAME}.local {
    tls internal
    reverse_proxy app:3000
}
