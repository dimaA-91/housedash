    "react-dom": "^19.2.5",
    "sharp": "^0.35.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@types/archiver": "^8.0.0",
